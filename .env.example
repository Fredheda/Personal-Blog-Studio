# Settings for infra/deploy.sh. Copy to .env (git-ignored). Values are not
# secrets except BLOG_WEB_CLIENT_SECRET, which deploy.sh prompts for instead of
# reading from a file; leave it unset here.
BLOG_TENANT_ID=
# Entra app registration (client) IDs written by the setup scripts (BLOG-15).
BLOG_WEB_CLIENT_ID=
BLOG_STUDIO_API_CLIENT_ID=
BLOG_API_CLIENT_ID=
# Comma-separated client IDs of the managed identities allowed to call the read
# API. At least one.
BLOG_APPROVED_CLIENT_IDS=
