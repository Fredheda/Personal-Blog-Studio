# Settings for infra/deploy.sh and the Entra scripts. Copy to .env (git-ignored,
# mode 600). The setup scripts fill most of it in: scripts/setup-api-auth.sh and
# scripts/setup-easyauth.sh. Never commit it.
BLOG_TENANT_ID=
# Entra object ID of the owner: the only identity the studio web app admits.
BLOG_OWNER_OBJECT_ID=
# Entra app registration (client) IDs.
BLOG_WEB_CLIENT_ID=
BLOG_STUDIO_API_CLIENT_ID=
BLOG_API_CLIENT_ID=
# Easy Auth client secret (2-year lifetime, see EXPIRATIONS.md). Written here
# (mode 600) by scripts/setup-easyauth.sh --apply. infra/deploy.sh prompts for it
# only when it is unset here.
BLOG_WEB_CLIENT_SECRET=
# Comma-separated client IDs of the identities allowed to call the read API.
# At least one (the gate caller is added by setup-api-auth.sh).
BLOG_APPROVED_CLIENT_IDS=
# Credential-less apps used by scripts/live-gate.sh.
BLOG_GATE_CALLER_CLIENT_ID=
BLOG_GATE_DENIED_CLIENT_ID=
# Custom domain of the studio web app and its managed certificate. Written by
# scripts/bind-domain.sh bind --apply. Set both or neither; deploy.sh refuses a
# deploy that would drop a domain that is bound.
BLOG_WEB_CUSTOM_DOMAIN=
BLOG_WEB_CERTIFICATE_NAME=
