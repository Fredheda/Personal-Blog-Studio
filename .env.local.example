# Complete local run on the DEV containers (docs: DEPLOYMENT.md, "Complete local run").
# Copy to .env.local (git-ignored). The backend servers and the seed script are
# run with it sourced (`set -a && . ../.env.local && set +a`); uvicorn's
# `--env-file` needs python-dotenv, which is not installed.
BLOG_STORAGE_ACCOUNT_URL=https://fhstorageportfolio.blob.core.windows.net
BLOG_DRAFTS_CONTAINER=blog-drafts-dev
BLOG_PUBLISHED_CONTAINER=blog-published-dev
BLOG_STUDIO_ORIGINS=http://127.0.0.1:3300
STUDIO_API_URL=http://127.0.0.1:8300
