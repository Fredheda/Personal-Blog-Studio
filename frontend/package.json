{
  "name": "blog-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/check-no-fonts.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "npm ci --prefix e2e/azurite && playwright install --with-deps chromium"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.23.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
