{
  "name": "blog-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-no-fonts.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "npm ci --prefix e2e/azurite && playwright install --with-deps chromium"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.5",
    "@milkdown/crepe": "7.23.0",
    "katex": "0.19.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
