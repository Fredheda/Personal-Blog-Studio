FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS builder

WORKDIR /app

# PIP_UPLOADED_PRIOR_TO: pip takes Poetry's own dependencies only from releases at least 14 days old.
RUN pip install --no-cache-dir pip==26.2.2 \
    && PIP_UPLOADED_PRIOR_TO=P14D pip install --no-cache-dir poetry==2.5.1 \
    && poetry config virtualenvs.in-project true

COPY pyproject.toml poetry.lock ./
RUN poetry install --only main,studio --no-interaction --no-ansi

FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

WORKDIR /app
RUN useradd --system --uid 10001 --no-create-home appuser
COPY --from=builder /app/.venv ./.venv
COPY blog_core/ ./blog_core/
COPY studio_api/ ./studio_api/
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1

USER appuser
EXPOSE 8000
CMD ["uvicorn", "studio_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
